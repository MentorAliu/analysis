{
  "components": {
    "schemas": {
      "CategoryName": {
        "enum": [
          "price",
          "derivatives",
          "fundamentals",
          "regime"
        ]
      },
      "CategoryState": {
        "enum": [
          "complete",
          "partial",
          "missing",
          "inapplicable"
        ]
      },
      "FeatureStateCounts": {
        "properties": {
          "available": {
            "format": "int32",
            "maximum": 21,
            "minimum": 0,
            "type": "integer"
          },
          "conflicted": {
            "format": "int32",
            "maximum": 21,
            "minimum": 0,
            "type": "integer"
          },
          "inapplicable": {
            "format": "int32",
            "maximum": 21,
            "minimum": 0,
            "type": "integer"
          },
          "invalid": {
            "format": "int32",
            "maximum": 21,
            "minimum": 0,
            "type": "integer"
          },
          "missing": {
            "format": "int32",
            "maximum": 21,
            "minimum": 0,
            "type": "integer"
          },
          "stale": {
            "format": "int32",
            "maximum": 21,
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "available",
          "missing",
          "stale",
          "invalid",
          "conflicted",
          "inapplicable"
        ],
        "type": "object"
      },
      "OperationalCheckResponse": {
        "properties": {
          "data": {
            "type": "object"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "data"
        ],
        "type": "object"
      },
      "OperationalHealthResponse": {
        "properties": {
          "checkedAtUtc": {
            "format": "date-time",
            "type": "string"
          },
          "checks": {
            "additionalProperties": {
              "$ref": "#/components/schemas/OperationalCheckResponse"
            },
            "type": "object"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "checkedAtUtc",
          "checks"
        ],
        "type": "object"
      },
      "RankingBatch": {
        "properties": {
          "asOfUtc": {
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$(?![\\s\\S])",
            "type": "string"
          },
          "createdAtUtc": {
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$(?![\\s\\S])",
            "type": "string"
          },
          "id": {
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
            "type": "string"
          },
          "inputHash": {
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
            "type": "string"
          },
          "knowledgeCutoffUtc": {
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$(?![\\s\\S])",
            "type": "string"
          },
          "model": {
            "$ref": "#/components/schemas/RankingModel"
          },
          "recordKind": {
            "pattern": "^research-reconstruction$(?![\\s\\S])",
            "type": "string"
          },
          "universeAssetIds": {
            "items": {
              "type": "string"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          }
        },
        "required": [
          "id",
          "asOfUtc",
          "knowledgeCutoffUtc",
          "createdAtUtc",
          "recordKind",
          "inputHash",
          "universeAssetIds",
          "model"
        ],
        "type": "object"
      },
      "RankingCategory": {
        "properties": {
          "applicableWeightNumerator": {
            "format": "int32",
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer"
          },
          "availableWeightNumerator": {
            "format": "int32",
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer"
          },
          "category": {
            "$ref": "#/components/schemas/CategoryName"
          },
          "dataQualityPercent": {
            "pattern": "^(?:100\\.000000|(?:0|[1-9][0-9]?)\\.[0-9]{6})$(?![\\s\\S])",
            "type": "string"
          },
          "score": {
            "pattern": "^(?!-0\\.000000$)-?(?:100\\.000000|(?:0|[1-9][0-9]?)\\.[0-9]{6})$(?![\\s\\S])",
            "type": [
              "null",
              "string"
            ]
          },
          "state": {
            "$ref": "#/components/schemas/CategoryState"
          }
        },
        "required": [
          "category",
          "state",
          "score",
          "dataQualityPercent",
          "applicableWeightNumerator",
          "availableWeightNumerator"
        ],
        "type": "object"
      },
      "RankingItem": {
        "properties": {
          "assetId": {
            "type": "string"
          },
          "bearishConfidenceScore": {
            "pattern": "^(?:100\\.000000|(?:0|[1-9][0-9]?)\\.[0-9]{6})$(?![\\s\\S])",
            "type": [
              "null",
              "string"
            ]
          },
          "bullishConfidenceScore": {
            "pattern": "^(?:100\\.000000|(?:0|[1-9][0-9]?)\\.[0-9]{6})$(?![\\s\\S])",
            "type": [
              "null",
              "string"
            ]
          },
          "categories": {
            "items": {
              "$ref": "#/components/schemas/RankingCategory"
            },
            "maxItems": 4,
            "minItems": 4,
            "type": "array"
          },
          "compositeScore": {
            "pattern": "^(?!-0\\.000000$)-?(?:100\\.000000|(?:0|[1-9][0-9]?)\\.[0-9]{6})$(?![\\s\\S])",
            "type": [
              "null",
              "string"
            ]
          },
          "featureHash": {
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
            "type": "string"
          },
          "featureSnapshotId": {
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quality": {
            "$ref": "#/components/schemas/RankingQuality"
          },
          "rank": {
            "format": "int32",
            "maximum": 3,
            "minimum": 1,
            "type": [
              "null",
              "integer"
            ]
          },
          "scoreHash": {
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
            "type": "string"
          },
          "scoreSnapshotId": {
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/RankingState"
          },
          "symbol": {
            "type": "string"
          }
        },
        "required": [
          "assetId",
          "symbol",
          "name",
          "rank",
          "scoreSnapshotId",
          "featureSnapshotId",
          "scoreHash",
          "featureHash",
          "state",
          "compositeScore",
          "bullishConfidenceScore",
          "bearishConfidenceScore",
          "quality",
          "categories"
        ],
        "type": "object"
      },
      "RankingModel": {
        "properties": {
          "calculatorSourceHash": {
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
            "type": "string"
          },
          "featureVersion": {
            "type": "string"
          },
          "id": {
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$(?![\\s\\S])",
            "type": "string"
          },
          "manifestHash": {
            "pattern": "^[0-9a-f]{64}$(?![\\s\\S])",
            "type": "string"
          },
          "numericVersion": {
            "type": "string"
          },
          "scorerVersion": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "weightDenominator": {
            "format": "int32",
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "id",
          "manifestHash",
          "calculatorSourceHash",
          "featureVersion",
          "scorerVersion",
          "numericVersion",
          "status",
          "weightDenominator"
        ],
        "type": "object"
      },
      "RankingQuality": {
        "properties": {
          "contextCoveragePercent": {
            "pattern": "^(?:100\\.000000|(?:0|[1-9][0-9]?)\\.[0-9]{6})$(?![\\s\\S])",
            "type": "string"
          },
          "corePriceReady": {
            "type": "boolean"
          },
          "dataQualityPercent": {
            "pattern": "^(?:100\\.000000|(?:0|[1-9][0-9]?)\\.[0-9]{6})$(?![\\s\\S])",
            "type": "string"
          },
          "featureStateCounts": {
            "$ref": "#/components/schemas/FeatureStateCounts"
          },
          "providerAgreement": {
            "pattern": "^unassessed-single-source$(?![\\s\\S])",
            "type": "string"
          }
        },
        "required": [
          "dataQualityPercent",
          "contextCoveragePercent",
          "providerAgreement",
          "corePriceReady",
          "featureStateCounts"
        ],
        "type": "object"
      },
      "RankingSelection": {
        "enum": [
          "latest",
          "exact"
        ]
      },
      "RankingState": {
        "enum": [
          "complete",
          "partial",
          "not-ready"
        ]
      },
      "RankingsProblem": {
        "properties": {
          "code": {
            "type": [
              "null",
              "string"
            ]
          },
          "correlationId": {
            "type": "string"
          },
          "errors": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "type": [
              "null",
              "object"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "format": "int32",
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "traceId": {
            "type": "string"
          },
          "type": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "correlationId",
          "traceId"
        ],
        "type": "object"
      },
      "RankingsResponse": {
        "properties": {
          "asOfAgeSeconds": {
            "maximum": 315537897599,
            "minimum": 0,
            "type": "integer"
          },
          "batch": {
            "$ref": "#/components/schemas/RankingBatch"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/RankingItem"
            },
            "maxItems": 3,
            "minItems": 3,
            "type": "array"
          },
          "requestedAsOfUtc": {
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:00:00Z$(?![\\s\\S])",
            "type": [
              "null",
              "string"
            ]
          },
          "retrievedAtUtc": {
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$(?![\\s\\S])",
            "type": "string"
          },
          "scoreUnit": {
            "pattern": "^score-points$(?![\\s\\S])",
            "type": "string"
          },
          "selection": {
            "$ref": "#/components/schemas/RankingSelection"
          }
        },
        "required": [
          "selection",
          "requestedAsOfUtc",
          "retrievedAtUtc",
          "asOfAgeSeconds",
          "scoreUnit",
          "batch",
          "items"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Analysis.Api | v1",
    "version": "1.0.0"
  },
  "openapi": "3.1.1",
  "paths": {
    "/api/health/live": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationalHealthResponse"
                }
              }
            },
            "description": "OK"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationalHealthResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "tags": [
          "Operations"
        ]
      }
    },
    "/api/health/ready": {
      "get": {
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationalHealthResponse"
                }
              }
            },
            "description": "OK"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationalHealthResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "tags": [
          "Operations"
        ]
      }
    },
    "/api/v1/rankings": {
      "get": {
        "description": "Historical as-of requires an exact stored UTC hour. Default model is slice1-v1. Results are research reconstructions, not probabilities or contemporaneously issued signals.",
        "operationId": "GetRankings",
        "parameters": [
          {
            "description": "Exact persisted model identity; never automatically selects a newer model.",
            "in": "query",
            "name": "modelId",
            "schema": {
              "default": "slice1-v1",
              "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$(?![\\s\\S])",
              "type": "string"
            }
          },
          {
            "description": "Exact stored UTC hour; omission selects greatest persisted as-of for the chosen model.",
            "in": "query",
            "name": "asOfUtc",
            "schema": {
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:00:00Z$(?![\\s\\S])",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RankingsResponse"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RankingsProblem"
                }
              }
            },
            "description": "Bad Request"
          },
          "403": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RankingsProblem"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RankingsProblem"
                }
              }
            },
            "description": "Not Found"
          },
          "405": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RankingsProblem"
                }
              }
            },
            "description": "Method Not Allowed"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RankingsProblem"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/RankingsProblem"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Read one private persisted ranking batch",
        "tags": [
          "Rankings"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Operations"
    },
    {
      "name": "Rankings"
    }
  ]
}
